{
  "hosting": {
    "site": "taliferro-email-signature-builder",
    "public": "dist/email-signature-builder/browser",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ]
  }
}
